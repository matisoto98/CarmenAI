{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plenergy.internal/carmen/eval/modes-labeled.schema.json",
  "title": "Conjunto etiquetado de modos de respuesta (2.3.2, 2.3.4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "casos"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "descripcion": {
      "type": "string"
    },
    "casos": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/caso"
      }
    }
  },
  "$defs": {
    "caso": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pregunta",
        "locale",
        "role",
        "modo",
        "fuente"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M[0-9]{2}$"
        },
        "pregunta": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "$ref": "https://plenergy.internal/carmen/common.schema.json#/$defs/locale"
        },
        "role": {
          "$ref": "https://plenergy.internal/carmen/common.schema.json#/$defs/role"
        },
        "modo": {
          "$ref": "https://plenergy.internal/carmen/common.schema.json#/$defs/responseMode"
        },
        "agentes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://plenergy.internal/carmen/common.schema.json#/$defs/agentId"
          }
        },
        "par": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "fuente": {
          "enum": [
            "2.3.3",
            "2.3.4",
            "2.3.5",
            "2.3.6",
            "5.17.7",
            "golden"
          ]
        },
        "canonicos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.json$"
          }
        },
        "nota": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
