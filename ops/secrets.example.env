WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
CARMEN_MTLS_CERT=
CARMEN_ENTRA_CLIENT_SECRET=
CARMEN_DATA_KEY=
# Credencial por aplicación del proxy de inferencia (4.1.3, condición 2)
INFERENCE_PROXY_CREDENTIAL=
