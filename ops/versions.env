# ops/versions.env — ÚNICA fuente de verdad de versiones (sección 4.3).
# Actualizar aquí exige pull request y ejecutar el arnés completo.
# Los marcadores <digest> se admiten en el perfil dev; el perfil prod no arranca con ellos.

OLLAMA_MIN_VERSION=0.17.5
OLLAMA_IMAGE=ollama/ollama@sha256:<digest>
INFERENCE_URL=https://<proxy-inferencia>
MODEL_ID=qwen3.5:9b
MODEL_QUANT=Q8_0
MODEL_DIGEST=<digest>
MODEL_NUM_CTX=16384
PLANNER_THINKING=false
EMBED_MODEL_ID=bge-m3
EMBED_MODEL_DIGEST=<digest>
EMBED_DIM=1024
NGINX_IMAGE=nginx@sha256:<digest>
POSTGRES_IMAGE=pgvector/pgvector@sha256:<digest>
PYTHON_VERSION=3.12
NODE_VERSION=20

# Procedimiento de actualización:
# 1. cambiar el digest o la versión en este fichero
# 2. ejecutar el arnés completo contra el simulado
# 3. modo sombra si cambia el modelo o su cuantización
# 4. actualizar la línea base con justificación escrita
